{
  "functions": [
    {
      "codebase": "default",
      "source": "BackEnd"
    },
    {
      "source": "lelei",
      "codebase": "lelei",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "BackEnd/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/health",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      },
      {
        "source": "/createAuthUser",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      },
      {
        "source": "/updateAuthPassword",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      },
      {
        "source": "/deleteAuthUser",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      },
      {
        "source": "/testFirebase",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      }
    ]
  }
}
