rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function privileged() {
      return signedIn() && request.auth.token.role in ['manager', 'admin', 'owner'];
    }
    function administrator() {
      return signedIn() && request.auth.token.role in ['admin', 'owner'];
    }
    function employeeAccount(data) {
      return data.get('role', 'employee') != 'manager' && data.get('accountRole', 'employee') != 'manager';
    }
    function owns(data) { return signedIn() && data.uid == request.auth.uid; }

    match /users/{id} {
      allow read: if privileged() || owns(resource.data);
      allow create: if privileged() || (signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.role == 'employee');
      allow update: if (owns(resource.data) && employeeAccount(resource.data) && employeeAccount(request.resource.data) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || administrator() || (signedIn() && request.auth.token.role == 'manager' && !owns(resource.data) && employeeAccount(resource.data) && employeeAccount(request.resource.data));
      allow delete: if administrator() || (signedIn() && request.auth.token.role == 'manager' && employeeAccount(resource.data));
    }
    match /employees/{id} {
      allow read: if privileged() || owns(resource.data);
      allow update: if administrator() || (owns(resource.data) && employeeAccount(resource.data) && employeeAccount(request.resource.data)) || (signedIn() && request.auth.token.role == 'manager' && !owns(resource.data) && employeeAccount(resource.data) && employeeAccount(request.resource.data));
      allow delete: if administrator() || (owns(resource.data) && employeeAccount(resource.data)) || (signedIn() && request.auth.token.role == 'manager' && employeeAccount(resource.data));
      allow create: if privileged() || owns(request.resource.data);
    }
    match /orders/{id} {
      allow read, update: if privileged() || owns(resource.data);
      allow create: if privileged() || owns(request.resource.data);
      allow delete: if privileged();
    }
    match /expenses/{id} {
      allow read, update: if privileged() || owns(resource.data);
      allow create: if privileged() || owns(request.resource.data);
      allow delete: if privileged();
    }
    match /attendance/{id} {
      allow read: if privileged() || owns(resource.data) || (signedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow create: if administrator() || owns(request.resource.data) || (signedIn() && request.resource.data.get('userId', '') == request.auth.uid && request.resource.data.get('accountRole', 'employee') == 'employee' && request.resource.data.status == 'pending' && request.resource.data.type == 'time_in_request') || (signedIn() && request.auth.token.role == 'manager' && request.resource.data.get('userId', '') == request.auth.uid && request.resource.data.get('accountRole', '') == 'manager' && request.resource.data.status == 'pending' && request.resource.data.type == 'time_in_request');
      allow update: if administrator() || (signedIn() && request.auth.token.role == 'manager' && resource.data.get('accountRole', 'employee') != 'manager') || (signedIn() && request.auth.token.role == 'manager' && resource.data.get('userId', '') == request.auth.uid && resource.data.get('accountRole', '') == 'manager' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'type', 'timeOutRequestedAt']) && request.resource.data.status == 'time_out_pending' && request.resource.data.type == 'time_out_request') || (signedIn() && resource.data.get('userId', '') == request.auth.uid && resource.data.get('accountRole', 'employee') == 'employee');
      allow delete: if privileged();
    }
    match /expenseReports/{id} {
      allow read, update: if privileged() || owns(resource.data);
      allow create: if privileged() || owns(request.resource.data);
      allow delete: if privileged();
    }
    match /employeeNotifications/{id} {
      allow read, update: if privileged() || owns(resource.data);
      allow create: if privileged() || owns(request.resource.data);
      allow delete: if privileged();
    }
    match /managerNotifications/{id} {
      allow read, write: if privileged();
    }
    match /auditLogs/{id} {
      allow read: if privileged();
      allow write: if false;
    }
    match /products/{id} {
      allow read: if signedIn();
      allow write: if administrator();
    }
    match /inventory/{id} {
      allow read: if signedIn();
      allow write: if administrator();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
